@page
@{
    ViewData["Title"] = "Infrastructure";
}

<section class="page-hero">
    <div class="page-hero-bg infrastructure-bg"></div>
    <div class="hero-overlay"></div>
    <div class="page-hero-content">
        <span class="pill"><i></i> PRODUCTION CAPABILITY</span>
        <h1>ENGINEERED<br /><em>TO PRODUCE.</em></h1>
        <p>A compact injection moulding setup designed for dependable and flexible production.</p>
    </div>
</section>

<section class="section">
    <div class="section-heading reveal">
        <div><span class="eyebrow">OUR MACHINES</span><h2>FOUR MACHINES.<br /><em>ONE STANDARD.</em></h2></div>
    </div>

    <div class="machine-list">
        <article class="machine-detail reveal"><div class="machine-index">01</div><div><span class="eyebrow">INJECTION MOULDING</span><h2>TOSHIBA</h2><p>High-capacity injection moulding platform for larger and demanding components.</p></div><strong>200 <small>TON</small></strong></article>
        <article class="machine-detail reveal"><div class="machine-index">02</div><div><span class="eyebrow">INJECTION MOULDING</span><h2>NILGIRI</h2><p>Versatile production capacity for consistent moulded parts and packaging.</p></div><strong>150 <small>TON</small></strong></article>
        <article class="machine-detail reveal"><div class="machine-index">03</div><div><span class="eyebrow">INJECTION MOULDING</span><h2>ELECTRONICA</h2><p>Efficient and repeatable production for medium-sized components.</p></div><strong>120 <small>TON</small></strong></article>
        <article class="machine-detail reveal"><div class="machine-index">04</div><div><span class="eyebrow">INJECTION MOULDING</span><h2>ELECTRONICA</h2><p>Flexible capacity for smaller components and varied production requirements.</p></div><strong>110 <small>TON</small></strong></article>
    </div>
</section>

<section class="dark-panel">
    <div class="section dark-section">
        <div class="split-section no-pad">
            <div class="split-label"><span>02</span><span>CAPABILITY</span></div>
            <div class="split-content">
                <span class="eyebrow">PRODUCTION MINDSET</span>
                <h2>PRECISION AT<br /><em>EVERY STEP.</em></h2>
                <p>Our equipment mix lets us select an appropriate production setup for different part sizes and requirements. This creates flexibility without compromising our focus on consistent output.</p>
            </div>
        </div>
    </div>
</section>
