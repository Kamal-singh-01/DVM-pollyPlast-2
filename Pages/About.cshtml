@page
@{
    ViewData["Title"] = "About Us";
}

<section class="page-hero">
    <div class="page-hero-bg about-bg"></div>
    <div class="hero-overlay"></div>
    <div class="page-hero-content">
        <span class="pill"><i></i> ABOUT DVM POLYPLAST</span>
        <h1>BUILT AROUND<br /><em>PRECISION.</em></h1>
        <p>Plastic manufacturing with a practical focus on quality, consistency and customer requirements.</p>
    </div>
</section>

<section class="split-section section">
    <div class="split-label reveal"><span>01</span><span>OUR STORY</span></div>
    <div class="split-content reveal">
        <span class="eyebrow">DVM POLYPLAST</span>
        <h2>MAKING PLASTIC<br /><em>WORK BETTER.</em></h2>
        <p>DVM polyPlast is focused on manufacturing dependable plastic components and packaging solutions. Our approach combines modern injection moulding equipment, disciplined production practices and attention to detail.</p>
        <p>We work with customers who need consistent parts, responsive communication and production that can scale with demand.</p>
    </div>
</section>

<section class="dark-panel">
    <div class="section dark-section">
        <div class="center-heading reveal">
            <span class="eyebrow">OUR PRINCIPLES</span>
            <h2>THE WAY WE<br /><em>WORK.</em></h2>
        </div>
        <div class="principles">
            <div class="principle reveal"><span>01</span><h3>CONSISTENCY</h3><p>Repeatable processes and controlled production for dependable output.</p></div>
            <div class="principle reveal"><span>02</span><h3>QUALITY</h3><p>Inspection and process discipline at every important production stage.</p></div>
            <div class="principle reveal"><span>03</span><h3>FLEXIBILITY</h3><p>Solutions shaped around part requirements, materials and volumes.</p></div>
        </div>
    </div>
</section>

<section class="section">
    <div class="section-heading reveal">
        <div><span class="eyebrow">OUR PROMISE</span><h2>FROM IDEA TO<br /><em>PRODUCTION.</em></h2></div>
    </div>
    <div class="process-grid">
        <div class="process reveal"><b>01</b><h3>REQUIREMENT</h3><p>Understand the part, material, quantity and application.</p></div>
        <div class="process reveal"><b>02</b><h3>PLANNING</h3><p>Select the appropriate process and production setup.</p></div>
        <div class="process reveal"><b>03</b><h3>MOULDING</h3><p>Manufacture with controlled injection moulding processes.</p></div>
        <div class="process reveal"><b>04</b><h3>INSPECTION</h3><p>Check output against defined quality expectations.</p></div>
    </div>
</section>
