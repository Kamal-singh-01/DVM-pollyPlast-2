@page
@{
    ViewData["Title"] = "Contact";

    var selectedProduct = Request.Query["product"].ToString();

   if (string.IsNullOrWhiteSpace(selectedProduct))
{
    selectedProduct = "Other";
}
}

<section class="page-hero compact">

    <div class="page-hero-bg contact-bg"></div>

    <div class="hero-overlay"></div>

    <div class="page-hero-content">

        <span class="pill">
            <i></i> LET'S WORK TOGETHER
        </span>

        <h1>
            START A<br />
            <em>PROJECT.</em>
        </h1>

        <p>
            Tell us what you need.
            We'll help you identify the right production approach.
        </p>

    </div>

</section>


<section class="section contact-section">

    <div class="contact-info reveal">

        <span class="eyebrow">
            CONTACT DVM POLYPLAST
        </span>

        <h2>
            LET'S TALK<br />
            <em>BUSINESS.</em>
        </h2>

        <p>
            For product enquiries, custom moulding requirements
            or manufacturing discussions, reach out directly.
        </p>


        <div class="contact-block">

            <span class="eyebrow">
                ADDRESS
            </span>

            <p>
                76, Ground Floor, Siddhi Vinayak Colony,<br />
                New Sidcul Bypass, Alampur, Bhadrabad,<br />
                Uttarakhand, India
            </p>

        </div>


        <div class="contact-block">

            <span class="eyebrow">
                PHONE
            </span>

            <a href="tel:+917525291155">
                +91 75252 91155
            </a>

        </div>


        <div class="contact-block">

            <span class="eyebrow">
                EMAIL
            </span>

            <a href="mailto:info@dvm-polyplast.com">
                info@dvm-polyplast.com
            </a>

        </div>

    </div>


    <form class="enquiry-form reveal" id="enquiryForm">

        <span class="eyebrow">
            SEND AN ENQUIRY
        </span>


        <div class="form-row">

            <label>
                YOUR NAME

                <input
                    required
                    name="name"
                    placeholder="Full name" />

            </label>


            <label>
                COMPANY

                <input
                    name="company"
                    placeholder="Company name" />

            </label>

        </div>


        <div class="form-row">

            <label>
                EMAIL

                <input
                    required
                    type="email"
                    name="email"
                    placeholder="you@company.com" />

            </label>


            <label>
                PHONE

                <input
                    name="phone"
                    placeholder="+91 ..." />

            </label>

        </div>


       <label>
    WHAT DO YOU NEED?

    <select name="requirement">

        @if (selectedProduct == "CTC Cap - 29/21mm")
        {
            <option value="CTC Cap - 29/21mm" selected>
                CTC Cap - 29/21mm
            </option>
        }
        else
        {
            <option value="CTC Cap - 29/21mm">
                CTC Cap - 29/21mm
            </option>
        }


        @if (selectedProduct == "CTC Cap - 36/29mm")
        {
            <option value="CTC Cap - 36/29mm" selected>
                CTC Cap - 36/29mm
            </option>
        }
        else
        {
            <option value="CTC Cap - 36/29mm">
                CTC Cap - 36/29mm
            </option>
        }


        @if (selectedProduct == "Butterfly Cap with Handle - 46mm")
        {
            <option value="Butterfly Cap with Handle - 46mm" selected>
                Butterfly Cap with Handle - 46mm
            </option>
        }
        else
        {
            <option value="Butterfly Cap with Handle - 46mm">
                Butterfly Cap with Handle - 46mm
            </option>
        }


        @if (selectedProduct == "2 Ltr Bottle Handle - 28mm")
        {
            <option value="2 Ltr Bottle Handle - 28mm" selected>
                2 Ltr Bottle Handle - 28mm
            </option>
        }
        else
        {
            <option value="2 Ltr Bottle Handle - 28mm">
                2 Ltr Bottle Handle - 28mm
            </option>
        }


        @if (selectedProduct == "Bubble Top-Cap - 24mm")
        {
            <option value="Bubble Top-Cap - 24mm" selected>
                Bubble Top-Cap - 24mm
            </option>
        }
        else
        {
            <option value="Bubble Top-Cap - 24mm">
                Bubble Top-Cap - 24mm
            </option>
        }


        @if (selectedProduct == "Other")
        {
            <option value="Other" selected>
                Other
            </option>
        }
        else
        {
            <option value="Other">
                Other
            </option>
        }

    </select>

</label>


        <label>
            MESSAGE

            <textarea
                required
                name="message"
                rows="6"
                placeholder="Tell us about your requirement..."></textarea>

        </label>


        <button
            class="button button-dark"
            type="submit">

            SEND ENQUIRY

            <span>↗</span>

        </button>


        <small class="form-note">
            This static version opens your email client.
            No data is stored on a server.
        </small>

    </form>

</section>