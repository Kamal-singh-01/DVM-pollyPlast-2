<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="DVM polyPlast — precision plastic manufacturing and packaging solutions." />
    <title>@ViewData["Title"] — DVM polyPlast</title>
    <link rel="icon" type="image/png" href="~/images/dvm-logo.png" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header" id="siteHeader">
        <div class="nav-shell">
            <a class="brand" asp-page="/Index" aria-label="DVM polyPlast home">
                <img src="~/images/dvm-logo.png" alt="DVM polyPlast logo" />
            </a>

            <button class="menu-toggle" id="menuToggle" aria-label="Open navigation" aria-expanded="false">
                <span></span><span></span><span></span>
            </button>

            <nav class="main-nav" id="mainNav">
                <a asp-page="/Index" class="nav-link">About</a>
                <a asp-page="/Products" class="nav-link">Products</a>
                <a asp-page="/Infrastructure" class="nav-link">Infrastructure</a>
                <a href="#capabilities" class="nav-link">Capabilities</a>
                <a href="#clients" class="nav-link">Clients</a>
                <a asp-page="/About" class="nav-link">Insights</a>
                <a href="#contact" class="nav-link">Contact</a>
                <a asp-page="/Contact" class="quote-btn">Get a Quote <span>↗</span></a>
            </nav>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <a class="whatsapp" href="https://wa.me/917525291155" target="_blank" rel="noopener" aria-label="Chat on WhatsApp">◔</a>

    <footer class="site-footer" id="contact">
        <div class="footer-grid">
            <div class="footer-brand">
                <img src="~/images/dvm-logo.png" alt="DVM polyPlast" />
                <div class="address-card">
                    <span class="eyebrow">HEADQUARTERS</span>
                    <p>76, Ground Floor, Siddhi Vinayak Colony,<br />
                    New Sidcul Bypass, Alampur, Bhadrabad,<br />
                    Uttarakhand, India</p>
                </div>
                <div class="footer-contact">
                    <a href="tel:+917525291155">+91 75252 91155</a>
                    <a href="mailto:info@dvm-polyplast.com">info@dvm-polyplast.com</a>
                </div>
            </div>

            <div class="footer-column">
                <span class="eyebrow">COMPANY</span>
                <a asp-page="/About">ABOUT US</a>
                <a asp-page="/Infrastructure">INFRASTRUCTURE</a>
                <a asp-page="/About">QUALITY</a>
                <a asp-page="/Contact">CONTACT</a>
            </div>

            <div class="footer-column">
                <span class="eyebrow">PRODUCTS</span>
                <a asp-page="/Products">CAPS & CLOSURES</a>
                <a asp-page="/Products">PLASTIC PRODUCTS</a>
                <a asp-page="/Products">CUSTOM MOULDS</a>
                <a asp-page="/Products">INDUSTRIAL PARTS</a>
            </div>
        </div>

        <div class="footer-bottom">
            <span>© 2026 DVM polyPlast. All rights reserved.</span>
            <div class="footer-links">
                <a href="#">Privacy Policy</a>
                <a href="#">LinkedIn</a>
                <a href="#">Instagram</a>
            </div>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
