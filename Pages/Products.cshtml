
@page
@{
    ViewData["Title"] = "Products";
}

<section class="page-hero">
    <div class="page-hero-bg products-bg"></div>
    <div class="hero-overlay"></div>

    <div class="page-hero-content">
        <span class="pill">
            <i></i> PRODUCT RANGE
        </span>

        <h1>
            PRECISION<br />
            <em>PRODUCTS.</em>
        </h1>

        <p>
            Precision-moulded plastic components and packaging
            solutions manufactured for reliable performance.
        </p>
    </div>
</section>


<section class="section products-showcase">

    <div class="section-heading reveal">
        <div>
            <span class="eyebrow">WHAT WE MAKE</span>

            <h2>
                OUR<br />
                <em>PRODUCTS.</em>
            </h2>
        </div>

        <p class="heading-note">
            Explore our range of precision plastic products.
            Click any product to send an enquiry.
        </p>
    </div>


    <div class="product-showcase-grid">


        <!-- PRODUCT 01 -->
        <a class="product-showcase-card reveal"
           asp-page="/Contact"
           asp-route-product="CTC Cap - 29/21mm">

           <div class="product-showcase-image">
    <img src="~/images/ctc-cap-29-21.jpeg" alt="CTC Cap 29/21 mm" />
</div>

            <div class="product-showcase-content">

                <span class="product-number">01</span>

                <h3>CTC CAP</h3>

                <p class="product-description">
                    Precision-moulded CTC cap designed for
                    consistent dimensions and reliable sealing.
                </p>

                <div class="product-specs">

                    <div>
                        <span>SIZE</span>
                        <strong>29/21 mm</strong>
                    </div>

                    <div>
                        <span>WEIGHT</span>
                        <strong>3 gm</strong>
                    </div>

                    <div>
                        <span>PRICE</span>
                        <strong>₹0.69 + GST</strong>
                    </div>

                </div>

                <div class="product-enquire">
                    ENQUIRE NOW
                    <span>↗</span>
                </div>

            </div>
        </a>


        <!-- PRODUCT 02 -->
        <a class="product-showcase-card reveal"
           asp-page="/Contact"
           asp-route-product="CTC Cap - 36/29mm">

           <div class="product-showcase-image">
    <img src="~/images/ctc-cap-36-29.webp" alt="CTC Cap 29/21 mm" />
</div>

            <div class="product-showcase-content">

                <span class="product-number">02</span>

                <h3>CTC CAP</h3>

                <p class="product-description">
                    CTC cap with a larger size specification,
                    manufactured for consistent fit and performance.
                </p>

                <div class="product-specs">

                    <div>
                        <span>SIZE</span>
                        <strong>36/29 mm</strong>
                    </div>

                    <div>
                        <span>WEIGHT</span>
                        <strong>5 gm</strong>
                    </div>

                    <div>
                        <span>PRICE</span>
                        <strong>₹1.10 + GST</strong>
                    </div>

                </div>

                <div class="product-enquire">
                    ENQUIRE NOW
                    <span>↗</span>
                </div>

            </div>
        </a>


        <!-- PRODUCT 03 -->
        <a class="product-showcase-card reveal"
           asp-page="/Contact"
           asp-route-product="Butterfly Cap with Handle - 46mm">

            <div class="product-showcase-image">
    <img src="~/images/butterflyCap.jpeg" alt="CTC Cap 29/21 mm" />
</div>

            <div class="product-showcase-content">

                <span class="product-number">03</span>

                <h3>BUTTERFLY CAP WITH HANDLE</h3>

                <p class="product-description">
                    Butterfly cap with integrated handle designed
                    for convenient handling and reliable application.
                </p>

                <div class="product-specs">

                    <div>
                        <span>SIZE</span>
                        <strong>46 mm</strong>
                    </div>

                    <div>
                        <span>WEIGHT</span>
                        <strong>11 gm</strong>
                    </div>

                    <div>
                        <span>PRICE</span>
                        <strong>₹2.10 + GST</strong>
                    </div>

                </div>

                <div class="product-enquire">
                    ENQUIRE NOW
                    <span>↗</span>
                </div>

            </div>
        </a>


        <!-- PRODUCT 04 -->
        <a class="product-showcase-card reveal"
           asp-page="/Contact"
           asp-route-product="2 Ltr Bottle Handle - 28mm">

           <div class="product-showcase-image">
    <img src="~/images/bottle-handle-2ltr.jpeg" alt="CTC Cap 29/21 mm" />
</div>

            <div class="product-showcase-content">

                <span class="product-number">04</span>

                <h3>2 LTR BOTTLE HANDLE</h3>

                <p class="product-description">
                    Lightweight bottle handle designed for
                    convenient handling of 2 litre bottles.
                </p>

                <div class="product-specs">

                    <div>
                        <span>SIZE</span>
                        <strong>28 mm</strong>
                    </div>

                    <div>
                        <span>WEIGHT</span>
                        <strong>1.2 gm</strong>
                    </div>

                    <div>
                        <span>PRICE</span>
                        <strong>₹0.27 + GST</strong>
                    </div>

                </div>

                <div class="product-enquire">
                    ENQUIRE NOW
                    <span>↗</span>
                </div>

            </div>
        </a>


        <!-- PRODUCT 05 -->
        <a class="product-showcase-card reveal"
           asp-page="/Contact"
           asp-route-product="Bubble Top-Cap - 24mm">

           <div class="product-showcase-image">
    <img src="~/images/bubble-top-cap.jpeg" alt="CTC Cap 29/21 mm" />
</div>

            <div class="product-showcase-content">

                <span class="product-number">05</span>

                <h3>BUBBLE TOP-CAP</h3>

                <p class="product-description">
                    Precision-moulded bubble top-cap designed
                    for consistent dimensions and application.
                </p>

                <div class="product-specs">

                    <div>
                        <span>SIZE</span>
                        <strong>24 mm</strong>
                    </div>

                    <div>
                        <span>WEIGHT</span>
                        <strong>3.2 gm</strong>
                    </div>

                    <div>
                        <span>PRICE</span>
                        <strong>₹0.65 + GST</strong>
                    </div>

                </div>

                <div class="product-enquire">
                    ENQUIRE NOW
                    <span>↗</span>
                </div>

            </div>
        </a>

    </div>

</section>
